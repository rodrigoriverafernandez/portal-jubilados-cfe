{
  "kind": "collectionType",
  "collectionName": "articulos",
  "info": {
    "singularName": "articulo",
    "pluralName": "articulos",
    "displayName": "Articulo",
    "description": "Articulos premium con categorizacion editorial, autor y SEO"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    }
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true,
      "unique": true
    },
    "resumen": {
      "type": "text"
    },
    "contenido": {
      "type": "richtext"
    },
    "imagen_principal": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "galeria": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "categoria": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::categoria.categoria"
    },
    "autor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::autor.autor"
    },
    "destacado": {
      "type": "boolean",
      "default": false
    },
    "fecha_publicacion": {
      "type": "date"
    },
    "tiempo_lectura": {
      "type": "integer"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "text"
    }
  }
}
