{
  "kind": "collectionType",
  "collectionName": "eventos",
  "info": {
    "singularName": "evento",
    "pluralName": "eventos",
    "displayName": "Evento",
    "description": "Eventos editoriales, lanzamientos, y actividades programadas"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": true
    }
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "descripcion": {
      "type": "text"
    },
    "fecha": {
      "type": "date"
    },
    "ubicacion": {
      "type": "string"
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    }
  }
}
