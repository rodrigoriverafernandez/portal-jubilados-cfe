# ============================================
# PORTAL NACIONAL DE JUBILADOS CFE
# Environment Configuration Example
# ============================================
# Copy this file to .env and fill in the values

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=strapi_user
POSTGRES_PASSWORD=strapi_password
POSTGRES_DB=strapi_db
POSTGRES_PORT=5432

# ============================================
# Strapi CMS Configuration
# ============================================
STRAPI_PORT=1337
STRAPI_URL=http://localhost:1337
JWT_SECRET=your_jwt_secret_key_change_in_production_minimum_32_chars
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_change_in_production_minimum_32_chars
API_TOKEN_SALT=your_api_token_salt_change_in_production_minimum_32_chars

# ============================================
# Strapi Database Configuration
# ============================================
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=strapi_db
DATABASE_USERNAME=strapi_user
DATABASE_PASSWORD=strapi_password
DATABASE_SSL=false
DATABASE_FILENAME=

# ============================================
# Next.js Frontend Configuration
# ============================================
NEXT_PORT=3000

# Server-side API URL (used inside Docker by Node.js)
# When frontend runs in Docker, it uses this to connect to Strapi service
STRAPI_API_URL=http://strapi:1337

# Client-side API URL (used in browser, from outside Docker)
# Public URL that browsers use to access Strapi
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Nginx Configuration
# ============================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ============================================
# Production Configuration (for future use)
# ============================================
# DOMAIN=portal-jubilados.example.com
# ENABLE_HTTPS=false
# ENABLE_CERTBOT=false
